//      rese2     as HCMInfoTypeRecordRsrvdFld2Len2,
//      grpvl     as HCMGrpgValForPersAssignments,

      // HR Master Record: Infotype 0008 (Basic Pay)
      @ObjectModel.text.element: [ 'PayScaleTypeText' ]
      trfar as PayScaleType,
      
      @ObjectModel.text.element: [ 'PayScaleAreaText' ]
      trfgb as PayScaleArea,
      trfgr as PayScaleGroup,
      trfst as PayScaleLevel,/*
      stvor as NextIncreaseDate,
      orzst as CostOfLivingAllowanceLevel,
      partn as Partnership,*/
      @ObjectModel.foreignKey.association: '_Currency'
      waers as Currency,
       bsgrd as CapacityUtilizationLevel,
      @Semantics.amount.currencyCode: 'Currency'
     case '0440'
      when lga01 then bet01
      when lga02 then bet02
      when lga03 then bet03
      when lga04 then bet04
      when lga05 then bet05
      when lga06 then bet06
      when lga07 then bet07 
      when lga08 then bet08
      when lga09 then bet09
      else bet10
      end as Salary,
      @Semantics.text: true
      _tr10a.tartx as PayScaleTypeText,
     @Semantics.text: true
      _tr10g.tgbtx as PayScaleAreaText,
         
      
