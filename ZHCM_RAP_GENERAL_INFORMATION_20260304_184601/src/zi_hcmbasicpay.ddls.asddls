@AbapCatalog.viewEnhancementCategory: [#NONE]
@AccessControl.authorizationCheck: #NOT_REQUIRED
@EndUserText.label: 'HCM Basic Pay'
@Metadata.ignorePropagatedAnnotations: true
@ObjectModel.usageType:{
    serviceQuality: #X,
    sizeCategory: #S,
    dataClass: #MIXED
}
define view entity ZI_HCMBasicPay  as select from pa0008
  association [0..1] to t510a as _tr10a on $projection.PayScaleType = _tr10a.trfar and
                                            _tr10a.molga = '99'
  association [0..1] to t510g as _tr10g on $projection.PayScaleArea = _tr10g.trfgb and
                                                 _tr10g.molga = '99'
  association [0..1] to I_Currency as _Currency on $projection.Currency = _Currency.Currency
//  association [0..1] to ZI_HCM_PayGradeLevels as _PayGradeLevels on $projection.
association [0..1] to ZI_HCM_PayGradeLevels as _PayGradeLevels on $projection.PayScaleType = _PayGradeLevels.Sltyp and
                                                               $projection.PayScaleArea = _PayGradeLevels.Slreg and     
                                                               $projection.PayScaleGroup = _PayGradeLevels.Slgrp and     
                                                               $projection.PayScaleLevel = _PayGradeLevels.Sllvl    
                                                                 
                                                                    
{
      // HR Master Record: Key Fields
  key pernr     as HCMPersonnelNumber,
  key subty     as HCMSubtype,
  key objps     as HCMObjectIdentification,
      @Semantics.booleanIndicator: true
  key sprps     as HCMRecordIsLocked,
      @Semantics.businessDate.to: true
  key endda     as EndDate,
      @Semantics.businessDate.from: true
  key begda     as StartDate,
  key seqnr     as HCMSequentialNumber,

      // HR Master Record: Control Fields
//      aedtm as LastChangedDate,
//      uname as LastChangedByUser,
//      @Semantics.booleanIndicator:true
