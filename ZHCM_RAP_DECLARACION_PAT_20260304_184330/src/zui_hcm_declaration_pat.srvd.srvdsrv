  expose ZI_HCM_IMMOVABLES_DEC_PAT    as Immovables;
  expose ZI_HCM_VEHICLES_DEC_PAT      as Vehicles;
  expose ZI_HCM_VALUES_DEC_PAT        as Values;
  expose ZI_HCM_OTHERS_DEC_PAT        as Others;
  expose ZI_HCM_DEBITS_DEC_PAT        as Debits;
}